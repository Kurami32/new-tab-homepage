{
  "manifest_version": 3,
  "name": "New Tab Homepage",
  "version": "1.0.3",
  "description": "Use you Homepage URL for new tabs",
  "permissions": [
    "browserSettings",
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "new-tab.html"
  },
  "options_ui": {
    "page": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{56821874-fd5f-4584-9bdd-ee0072c3af24}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
